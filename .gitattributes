# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Scripts that must stay LF even on Windows checkouts.
*.sh text eol=lf

# Windows batch/PowerShell stay CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat known binaries as binary (no EOL munging, no diff noise).
*.png binary
*.jpg binary
*.jpeg binary
*.pptx binary
*.pdf binary
*.bin binary
*.mp4 binary
*.mkv binary
*.wav binary
*.mp3 binary
*.webm binary
