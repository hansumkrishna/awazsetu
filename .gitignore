# --- large downloaded weights (fetch via scripts/download_models.py) ---
/models/*
!/models/README.md

# --- runtime data: uploads, processed outputs, logs, generated media ---
/app/data/*
!/app/data/.gitkeep
app/settings.json

# --- personal / sample media & screenshots (not for the repo) ---
*.mp4
*.mkv
*.webm
*.wav
*.mp3
WhatsApp*.jpeg
WhatsApp*.jpg

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# --- misc / logs / OS ---
*.log
hf-cache/
.DS_Store
Thumbs.db
desktop.ini

# --- demo logistics notes & screenshots (contain meeting credentials) ---
# docs/ holds the shareable copies of the handover material.
/notes/
/screenshots/

# --- offline installer kit (large binaries, not for git) ---
/offline_kit/

# --- supplied test media ---
/Videos.zip
/test_videos/

# --- bundled zero-install runtime (embedded Python + ffmpeg, ~1.8 GB) ---
/runtime/

# --- supplied media staged for processing ---
/new_media/
/final submission.jpeg

# --- built distribution packages ---
/dist/

# stray tilde dir from an unexpanded shell path
/~/
